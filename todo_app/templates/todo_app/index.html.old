<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Todo List</title>
    <style>
        body { display: flex; height: 100vh; margin: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

        /* Chat Sidebar */
        #chat-sidebar {
            width: 350px;
            border-right: 1px solid #e0e0e0;
            display: flex;
            flex-direction: column;
            background: #f5f7f9;
        }
        #chat-header { padding: 15px; border-bottom: 1px solid #e0e0e0; background: #fff; font-weight: bold; display: flex; justify-content: space-between; align-items: center; }
        #clear-chat-btn { padding: 5px 12px; background: #dc3545; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 0.85em; }
        #clear-chat-btn:hover { background: #c82333; }
        #chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .message {
            max-width: 85%;
            padding: 10px 14px;
            border-radius: 12px;
            line-height: 1.4;
            font-size: 0.95em;
        }
        .message.user {
            background: #007bff;
            color: white;
            align-self: flex-end;
            border-bottom-right-radius: 2px;
        }
        .message.model {
            background: #ffffff;
            border: 1px solid #e0e0e0;
            align-self: flex-start;
            border-bottom-left-radius: 2px;
        }
        #chat-input-area { padding: 15px; background: #fff; border-top: 1px solid #e0e0e0; display: flex; gap: 10px; }
        #chat-input { flex: 1; padding: 10px; border: 1px solid #ddd; border-radius: 20px; outline: none; }
        #send-btn { padding: 8px 16px; background: #007bff; color: white; border: none; border-radius: 20px; cursor: pointer; }
        #send-btn:hover { background: #0056b3; }

        /* Task Main Area */
        #task-main { flex: 1; padding: 30px; overflow-y: auto; background: #fff; }
        h2 { margin-top: 0; color: #333; }
        #task-list { display: flex; flex-direction: column; gap: 15px; }
        .task-card {
            border: 1px solid #eee;
            padding: 15px;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            transition: transform 0.1s;
        }
        .task-card:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        .task-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; gap: 10px; }
        .task-title-section { display: flex; align-items: center; gap: 10px; flex: 1; }
        .task-checkbox { width: 18px; height: 18px; cursor: pointer; }
        .task-title { font-weight: 600; font-size: 1.1em; color: #2c3e50; }
        .task-title.completed { text-decoration: line-through; color: #888; }
        .task-date { font-size: 0.85em; color: #888; }
        .task-desc { color: #555; margin-bottom: 10px; font-size: 0.95em; }
        .task-tags { display: flex; gap: 5px; flex-wrap: wrap; }
        .tag { background: #e9ecef; color: #495057; padding: 2px 8px; border-radius: 12px; font-size: 0.8em; }
        .status-badge { padding: 2px 8px; border-radius: 4px; font-size: 0.8em; text-transform: uppercase; font-weight: bold; }
        .status-pending { background: #fff3cd; color: #856404; }
        .status-completed { background: #d4edda; color: #155724; }
    </style>
</head>
<body>
    <div id="chat-sidebar">
        <div id="chat-header">
            <span>AI Assistant</span>
            <button id="clear-chat-btn" onclick="clearChat()">Clear Chat</button>
        </div>
        <div id="chat-messages">
            <!-- Messages will appear here -->
        </div>
        <div id="chat-input-area">
            <input type="text" id="chat-input" placeholder="Type a message..." onkeypress="handleKeyPress(event)">
            <button id="send-btn" onclick="sendMessage()">Send</button>
        </div>
    </div>
    <div id="task-main">
        <h2>My Tasks</h2>
        <div id="task-list">
            <!-- Tasks will appear here -->
        </div>
    </div>

    <script>
        const chatMessages = document.getElementById('chat-messages');
        const chatInput = document.getElementById('chat-input');
        const taskList = document.getElementById('task-list');

        // Load initial data
        document.addEventListener('DOMContentLoaded', () => {
            loadChatHistory();
            loadTasks();
        });

        function handleKeyPress(e) {
            if (e.key === 'Enter') sendMessage();
        }

        async function sendMessage() {
            const text = chatInput.value.trim();
            if (!text) return;

            // Add user message to UI
            appendMessage('user', text);
            chatInput.value = '';

            try {
                const response = await fetch('/api/chat/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text })
                });
                const data = await response.json();

                if (data.response) {
                    appendMessage('model', data.response);
                    // Refresh tasks as the AI might have created one
                    loadTasks();
                } else if (data.error) {
                    appendMessage('model', 'Error: ' + data.error);
                }
            } catch (error) {
                console.error('Error:', error);
                appendMessage('model', 'Sorry, something went wrong.');
            }
        }

        function appendMessage(role, text) {
            const div = document.createElement('div');
            div.className = `message ${role}`;
            // Simple markdown-like parsing for bold
            div.innerHTML = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br>');
            chatMessages.appendChild(div);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        async function loadChatHistory() {
            try {
                const response = await fetch('/api/chat/history/');
                const messages = await response.json();
                messages.forEach(msg => {
                    appendMessage(msg.role, msg.content);
                });
            } catch (error) {
                console.error('Error loading chat history:', error);
            }
        }

        async function loadTasks() {
            try {
                const response = await fetch('/api/tasks/');
                const tasks = await response.json();
                renderTasks(tasks);
            } catch (error) {
                console.error('Error loading tasks:', error);
            }
        }

        function renderTasks(tasks) {
            taskList.innerHTML = '';
            tasks.forEach(task => {
                const card = document.createElement('div');
                card.className = 'task-card';

                const dateStr = task.due_date ? new Date(task.due_date).toLocaleString() : 'No due date';
                const statusClass = task.status === 'completed' ? 'status-completed' : 'status-pending';
                const isCompleted = task.status === 'completed';
                const titleClass = isCompleted ? 'task-title completed' : 'task-title';

                let tagsHtml = '';
                if (task.tags && task.tags.length > 0) {
                    tagsHtml = '<div class="task-tags">' +
                        task.tags.map(tag => `<span class="tag">#${tag.name}</span>`).join('') +
                        '</div>';
                }

                card.innerHTML = `
                    <div class="task-header">
                        <div class="task-title-section">
                            <input type="checkbox" class="task-checkbox" ${isCompleted ? 'checked' : ''} 
                                   onchange="toggleTaskStatus(${task.id}, this.checked)">
                            <span class="${titleClass}">${task.title}</span>
                        </div>
                        <span class="status-badge ${statusClass}">${task.status}</span>
                    </div>
                    <div class="task-date">${dateStr}</div>
                    <div class="task-desc">${task.description}</div>
                    ${tagsHtml}
                `;
                taskList.appendChild(card);
            });
        }

        async function toggleTaskStatus(taskId, isCompleted) {
            try {
                const status = isCompleted ? 'completed' : 'pending';
                const response = await fetch(`/api/tasks/${taskId}/`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: status })
                });
                
                if (response.ok) {
                    // Reload tasks to reflect changes
                    loadTasks();
                } else {
                    console.error('Failed to update task status');
                    // Reload to revert checkbox state
                    loadTasks();
                }
            } catch (error) {
                console.error('Error updating task:', error);
                loadTasks();
            }
        }

        async function clearChat() {
            if (!confirm('Are you sure you want to clear all chat history?')) {
                return;
            }
            
            try {
                // Delete all chat messages from the database
                const response = await fetch('/api/chat/clear/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                
                if (response.ok) {
                    // Clear the UI
                    chatMessages.innerHTML = '';
                } else {
                    alert('Failed to clear chat history');
                }
            } catch (error) {
                console.error('Error clearing chat:', error);
                alert('Error clearing chat history');
            }
        }
    </script>
</body>
</html>
